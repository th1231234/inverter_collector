# ==================================================================
# 默认配置模板：首次编译或重新生成 sdkconfig 时自动套用
# ------------------------------------------------------------------
# sdkconfig 本身已加入 .gitignore（避免真实 Wi-Fi 凭据进入公开仓库），
# 因此这里只放与硬件相关的固定项 + 占位符。
#
# 实际网络参数请在项目目录执行：
#     idf.py menuconfig
#   → Inverter Collector → Wi-Fi 参数 / 上报通道
# 保存后生成你自己的 sdkconfig，不会被提交。
# ==================================================================

# 目标芯片
CONFIG_IDF_TARGET="esp32c3"

# Flash 容量 2MB，单 app 分区
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="2MB"

# ---- Wi-Fi 参数（占位符，必须改成真实值）----
CONFIG_WIFI_SSID="YOUR_SSID"
CONFIG_WIFI_PASSWORD="YOUR_PASSWORD"

# ---- 上报通道 ----
# 默认 UDP（符合测验功能要求）；选 TCP 时改用 tcp.c
CONFIG_REPORT_PROTO_UDP=y
CONFIG_REPORT_TARGET_IP="192.168.1.200"
CONFIG_REPORT_TARGET_PORT=8080
